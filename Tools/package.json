{
  "name": "cinaclassics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cinaclassics — 中文古籍刻本风格直排电子书排版引擎（TypeScript / Cloudflare Workers）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "local": "tsx scripts/generate-local.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "r2:push:local": "tsx scripts/r2-push.ts --local",
    "r2:push": "tsx scripts/r2-push.ts --remote"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^22.7.0",
    "fonteditor-core": "^2.6.3",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "subset-font": "^2.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.15.0"
  }
}
